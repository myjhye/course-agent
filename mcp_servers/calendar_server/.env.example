# Google Calendar MCP Server Configuration

# Google Cloud Console에서 생성한 서비스 계정 키 JSON 파일의 문자열 데이터 전체를 입력하세요 (예: {"type": "service_account", ...})
GOOGLE_SERVICE_ACCOUNT_INFO='{"type": "service_account", "project_id": "your-project", ...}'

# 동기화 및 기록 대상이 될 구글 캘린더 ID (기본 캘린더일 경우 보통 소유자 이메일 주소, 혹은 공유 캘린더 ID)
GOOGLE_CALENDAR_ID="your-calendar-id@group.calendar.google.com"

# MCP 구동 포트 및 호스트
MCP_PORT=8002
MCP_HOST=127.0.0.1
